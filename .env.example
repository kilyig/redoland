# Redoland environment template.
# Copy this file to `.env.local` and fill in your key. `.env.local` is
# git-ignored, so your real key is never committed. The CLI and the Anthropic
# backend load it automatically (no python-dotenv needed).

# --- required for the real LLM backend -------------------------------------
# Your Anthropic API key. Read automatically by the SDK / AnthropicBackend.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- models (all agents on Haiku by default = cheapest) --------------------
REDOLAND_AGENT_MODEL=claude-haiku-4-5
REDOLAND_CHEAP_MODEL=claude-haiku-4-5

# --- intelligence dial -----------------------------------------------------
# 1 = give each agent a per-turn thinking budget = its intelligence gene
#     (extended thinking via budget_tokens; the continuous intelligence knob).
# 0 = disable thinking. Use this if Haiku rejects extended thinking with a 400;
#     agents still run, intelligence just no longer varies thinking depth.
REDOLAND_THINKING=1
